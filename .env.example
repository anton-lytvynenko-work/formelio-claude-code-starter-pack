# Copy this file to .env and fill in the values.
# NEVER commit the real .env — it is gitignored.
#
# Convention: one VAR_NAME=value per line. Group by service with a header
# comment. Add # required / # optional next to each variable.

# Example service — required
# EXAMPLE_API_KEY=replace_me
# EXAMPLE_BASE_URL=https://example.com

# Example service — optional
# EXAMPLE_TIMEOUT_MS=5000
